#!/bin/bash
set -eo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/common"

OUTPUT_DIR_PUT="${OUTPUT_DIR_PUT:-$REPO_ROOT/benchmarks/outputs/minio/warp_put_distributed}"
OUTPUT_DIR_GET="${OUTPUT_DIR_GET:-$REPO_ROOT/benchmarks/outputs/minio/warp_get_distributed}"
REPETITIONS="${REPETITIONS:-1}"
DURATION="${DURATION:-10}"
IDLE_WAIT="${IDLE_WAIT:-2}"
MODE="${MODE:-both}"
CONCURRENT=32
if [[ -n "${SIZES_OVERRIDE:-}" ]]; then
    read -ra SIZES <<<"$SIZES_OVERRIDE"
else
    SIZES=(4MiB 64MiB 512MiB 2GiB)
fi

WARP_ACCESS_KEY="${WARP_ACCESS_KEY:?WARP_ACCESS_KEY not set}"
WARP_SECRET_KEY="${WARP_SECRET_KEY:?WARP_SECRET_KEY not set}"

# Warp client port (default 7761)
WARP_CLIENT_PORT=7761

# Coordinator and client nodes
coordinator="srv01"
client_nodes=(srv02 srv03)

# Cleanup trap: remove remote temp files on interrupt/exit
REMOTE_TMP=""
cleanup() {
    if [[ -n "$REMOTE_TMP" ]]; then
        run_ansible "$coordinator" "shell" "rm -f ${REMOTE_TMP}*" > /dev/null 2>&1 || true
        REMOTE_TMP=""
    fi
}
trap cleanup EXIT
trap 'cleanup; exit 1' INT TERM

while [[ $# -gt 0 ]]; do
    case "$1" in
        --duration)    DURATION="$2";    shift 2 ;;
        --repetitions) REPETITIONS="$2"; shift 2 ;;
        --idle-wait)   IDLE_WAIT="$2";   shift 2 ;;
        --mode)        MODE="$2";        shift 2 ;;
        --output-dir)
            BASE="$2"
            OUTPUT_DIR_PUT="${BASE}/warp_put_distributed"
            OUTPUT_DIR_GET="${BASE}/warp_get_distributed"
            shift 2
            ;;
        --port)        WARP_CLIENT_PORT="$2"; shift 2 ;;
        --help|-h)
            echo "Usage: benchctl run minio distributed [--mode put|get|both] [--port <port>]"
            echo ""
            echo "Options:"
            echo "  --duration <seconds>   Duration per warp run (default: 10)"
            echo "  --repetitions <n>      Number of repetitions (default: 1)"
            echo "  --idle-wait <seconds>  Idle wait before snapshot (default: 2)"
            echo "  --mode <put|get|both>  Operation mode (default: both)"
            echo "  --port <port>        Warp client listener port (default: 7761)"
            echo ""
            echo "MinIO Server: st01-st08 (all storage nodes, port 9000)"
            echo "Warp clients: srv02 (192.168.11.32), srv03 (192.168.11.33)"
            echo "Coordinator: srv01"
            echo "Credentials: WARP_ACCESS_KEY / WARP_SECRET_KEY (from .env)"
            echo ""
            echo "NOTE: uses --warp-client flag; verify against installed warp version"
            exit 0
            ;;
        *)
            echo "Error: Unknown option: $1"
            echo "Use --help for usage"
            exit 1
            ;;
    esac
done

# Build --warp-client argument string from client node IPs
warp_client_arg=""
for node in "${client_nodes[@]}"; do
    ip="${APP_IPS[$node]}"
    if [[ -n "$warp_client_arg" ]]; then
        warp_client_arg="${warp_client_arg},${ip}:${WARP_CLIENT_PORT}"
    else
        warp_client_arg="${ip}:${WARP_CLIENT_PORT}"
    fi
done

# Build --host argument: all 8 storage nodes in single comma-separated value
# NOTE: warp treats repeated --host flags as overrides (last wins), not accumulation
warp_hosts="${STORAGE_IPS[st01]}:9000,${STORAGE_IPS[st02]}:9000,${STORAGE_IPS[st03]}:9000,${STORAGE_IPS[st04]}:9000,${STORAGE_IPS[st05]}:9000,${STORAGE_IPS[st06]}:9000,${STORAGE_IPS[st07]}:9000,${STORAGE_IPS[st08]}:9000"

warp_run() {
    local op="$1"   # put or get
    local size="$2"
    local rep="$3"
    local epoch="$4"
    local out_dir="$5"

    local tmp_base="/tmp/warp_${op}_${size}_rep${rep}_${epoch}_$$"
    local tmp_zst="${tmp_base}.json.zst"
    local tmp_local="/tmp/warp_fetch_${op}_${size}_rep${rep}_${epoch}_$$.zst"
    local out_file="$out_dir/${epoch}_${op}_distributed-${size}_rep${rep}_${coordinator}.json"

    echo "  Running ${op^^} ($size, rep $rep)..."

    REMOTE_TMP="$tmp_base"

    # NOTE: --warp-client is the correct flag name for the installed warp version;
    # the track spec uses --client which is an older alias. Verify with:
    #   warp put --help 2>&1 | grep -i client
    run_ansible "$coordinator" "shell" \
        "warp $op \
            --host $warp_hosts \
            --warp-client ${warp_client_arg} \
            --access-key $WARP_ACCESS_KEY --secret-key $WARP_SECRET_KEY \
            --obj.size $size --concurrent $CONCURRENT \
            --duration ${DURATION}s \
            --benchdata $tmp_base" \
        || { echo "Error: warp $op failed for $size rep $rep"; return 1; }

    run_ansible "$coordinator" "fetch" "src=$tmp_zst dest=$tmp_local flat=yes" \
        > /dev/null \
        || { echo "Error: fetch failed for $size rep $rep"; return 1; }

    zstd -d "$tmp_local" -o "$out_file" \
        || { echo "Error: decompress failed for $size rep $rep"; rm -f "$tmp_local" "$out_file"; return 1; }

    run_ansible "$coordinator" "shell" "rm -f $tmp_zst" > /dev/null || true
    rm -f "$tmp_local"
    REMOTE_TMP=""

    echo "  → $out_file"
}

echo "=== MinIO Distributed Multi-Client Benchmark (Section 2.2) ==="
echo "Coordinator: $coordinator"
echo "Clients: ${client_nodes[*]}"
echo "Warp client arg: $warp_client_arg"
echo "Duration: ${DURATION}s per run"
echo "Concurrent: $CONCURRENT"
echo "Repetitions: $REPETITIONS"
echo "Mode: $MODE"
echo "Sizes: ${SIZES[*]}"
echo ""

mkdir -p "$OUTPUT_DIR_PUT" "$OUTPUT_DIR_GET"

for rep in $(seq 1 $REPETITIONS); do
    echo "=== Repetition $rep/$REPETITIONS ==="

    for SIZE in "${SIZES[@]}"; do
        echo "  Size: $SIZE"

        if [[ "$MODE" == "put" || "$MODE" == "both" ]]; then
            EPOCH=$(date +%s)
            "$SCRIPT_DIR/system_snapshot" \
                --rep "$rep" \
                --meta "$coordinator" \
                --metric "put" \
                --qualifier "distributed-${SIZE}" \
                --epoch "$EPOCH" \
                --output-dir "$OUTPUT_DIR_PUT" \
                --idle-wait "$IDLE_WAIT" || echo "Warning: system_snapshot failed, continuing..."

            "$SCRIPT_DIR/warp" start
            warp_run "put" "$SIZE" "$rep" "$EPOCH" "$OUTPUT_DIR_PUT" \
                || echo "Warning: PUT failed for $SIZE rep $rep, continuing..."
        fi

        if [[ "$MODE" == "get" || "$MODE" == "both" ]]; then
            EPOCH=$(date +%s)
            "$SCRIPT_DIR/system_snapshot" \
                --rep "$rep" \
                --meta "$coordinator" \
                --metric "get" \
                --qualifier "distributed-${SIZE}" \
                --epoch "$EPOCH" \
                --output-dir "$OUTPUT_DIR_GET" \
                --idle-wait "$IDLE_WAIT" || echo "Warning: system_snapshot failed, continuing..."

            "$SCRIPT_DIR/warp" start
            warp_run "get" "$SIZE" "$rep" "$EPOCH" "$OUTPUT_DIR_GET" \
                || echo "Warning: GET failed for $SIZE rep $rep, continuing..."
        fi

        echo ""
    done
done

echo "=== MinIO Distributed Multi-Client Complete ==="
echo "PUT results: $OUTPUT_DIR_PUT"
echo "GET results: $OUTPUT_DIR_GET"
